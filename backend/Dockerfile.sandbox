# Sandbox image for executing untrusted user code.
# Build from the REPO ROOT so the engine packages are in the build context:
#
#   docker build -f backend/Dockerfile.sandbox -t mss-sandbox:latest .
#
FROM python:3.12-slim

# Scientific stack + the simulator engine.
RUN pip install --no-cache-dir numpy scipy sympy matplotlib

WORKDIR /opt/engine
COPY pyproject.toml README.md ./
COPY core ./core
COPY maths ./maths
COPY physics ./physics
COPY stats ./stats
RUN pip install --no-cache-dir .

# Execution harness (captures matplotlib figures).
COPY backend/app/sandbox/harness.py /opt/harness.py

# Run as an unprivileged user; headless matplotlib.
RUN useradd --create-home --uid 1000 runner
ENV MPLBACKEND=Agg \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/runner
USER runner
WORKDIR /work

CMD ["python", "/opt/harness.py", "/work/code.py", "/work/images.json"]
